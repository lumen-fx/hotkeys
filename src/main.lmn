<root padding="28" gap="16" bg="#0c1c30">
  <label class="title" height="40px" text="Native shell" />
  <label class="caption" text="Global hotkeys fire even while another app has focus. The tray icon (macOS / Windows) and OS notifications use the same shell surface." wrap="word" />
  <column class="group" padding="16" gap="8">
    <label class="group-title" text="Registered hotkeys" />
    <row gap="10" align="center">
      <label class="kbd" width="220px" text="Ctrl/Cmd + Shift + L" />
      <label class="caption" text="log a line" />
    </row>
    <row gap="10" align="center">
      <label class="kbd" width="220px" text="Ctrl/Cmd + Shift + K" />
      <label class="caption" text="send a notification" />
    </row>
    <row gap="12" align="center">
      <toggle id="armed" width="48px" height="28px" bind-checked="armed" checked="true" />
      <label class="caption" text="Hotkeys armed" />
    </row>
  </column>
  <row gap="10">
    <button id="notify-now" class="primary" width="180px" height="40px" text="Test notification" />
    <button id="clear-log" class="ghost" width="120px" height="40px" text="Clear log" />
  </row>
  <label class="caption" height="20px" text="Event log" bind-text="log_label" />
  <scroll grow="1">
    <for gap="4" each="log" key="id">
      <row class="log-row" height="32px" gap="10" align="center">
        <label class="log-kind" width="90px" text="{row.kind}" />
        <label class="log-text" grow="1" text="{row.text}" max-lines="1" wrap="none" />
      </row>
    </for>
  </scroll>
  <script src="main.rhai" />
</root>
